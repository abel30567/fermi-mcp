# local.env — YOUR machine's settings. Gitignored; never commit it.
# It keeps account names, wrapper scripts and model choices out of the repository.

# How one headless worker is started.
#   claude: Claude Code. launch.sh runs: $WORKER_CMD "<prompt>" --model M --output-format json --settings S
#           The --settings file loads hooks/worker-guard.mjs, which blocks forbidden commands.
#   custom: any other agent CLI. launch.sh runs: $WORKER_CMD <prompt-file>, with ORCH_MODEL set.
#           See adapters/ for examples. The guard hook does NOT run; rely on branch protection.
WORKER_KIND="claude"
WORKER_CMD="claude -p --permission-mode bypassPermissions"

BUILDER_MODEL="opus"       # builder + fixer: the strongest model you have
VERIFIER_MODEL="sonnet"    # verifier + blast radius: a different model is a feature, not a bug

# Isolated config dir so workers do not load your personal plugins, hooks or MCP servers.
WORKER_CONFIG_DIR="$HOME/.claude-orch-worker"

# Trailer added to every worker commit.
COAUTHOR="Co-Authored-By: Claude <noreply@anthropic.com>"

# Optional: a URL heartbeat checks (for example a local model proxy your workers depend on).
HEALTH_URL=""
