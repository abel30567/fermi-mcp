# orch.env — project settings for the orchestrator (committed; no secrets).
GH_REPO="abel30567/fermi-mcp"
BASE="master"
KEY_RE='[A-Z][A-Z0-9]*-[0-9]+'
GATES="bun install --frozen-lockfile && bunx biome check . && bun run --cwd packages/worker typecheck && npx tsc --noEmit -p packages/shared/tsconfig.json && bun run test"
PROTECTED_BRANCHES="main|master|develop|development|staging|production"
RESERVED_PORTS="8791|3847|8317"
MERGE_METHOD="squash"
BOARD_TITLE="Fermi harness evals"
JIRA_URL=""
JIRA_PROJECT=""
JIRA_STATUSES="To Do|Ready for Dev|In Progress|Blocked"
JIRA_POINTS_FIELD=""
