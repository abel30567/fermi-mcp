# orch.env — PROJECT settings for the orchestrator. Commit this file (no secrets in it).
# `install.sh` copies this to orch.env; edit the values, then run `orch doctor`.

# GitHub repository as owner/name. Leave empty to read it from `git remote get-url origin`.
GH_REPO=""

# The branch every pull request targets and the merge gate merges into.
BASE="main"

# Ticket key format (extended regex). Every branch, commit and PR title carries [KEY].
#   Jira:          '[A-Z][A-Z0-9]*-[0-9]+'   (PROJ-123)
#   GitHub only:   use `orch task "summary"`, which creates ISSUE-<n> keys (also matches the default).
KEY_RE='[A-Z][A-Z0-9]*-[0-9]+'

# The test gates every builder, verifier and fixer runs, as ONE shell command, from the repo root.
# Put the slow-but-complete suite here, not a smoke test. Examples:
#   Node:   GATES="npm ci && npx tsc --noEmit && npm test && npm run build"
#   Python: GATES="pip install -e '.[dev]' && ruff check . && mypy . && pytest -q"
#   Go:     GATES="go vet ./... && go test ./... && go build ./..."
GATES="npm ci && npm test && npm run build"

# Branches workers may never push to (regex alternation). BASE is always protected too.
PROTECTED_BRANCHES="main|master|develop|development|staging|production"

# Ports that belong to the orchestrator (your dev server, database, ...). Workers get 8161+.
RESERVED_PORTS=""

# Optional Jira mirror (orch sync-jira). Credentials come from the environment, never from this file:
#   export JIRA_EMAIL=you@company.com JIRA_API_TOKEN=...
JIRA_URL=""
JIRA_PROJECT=""
JIRA_STATUSES="To Do|Ready for Dev|In Progress|Blocked"
JIRA_POINTS_FIELD=""
